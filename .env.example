# Mezon Bot
MEZON_TOKEN=your_bot_token
MEZON_BOT_ID=your_bot_id

# Bot Central Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/mezon_english_bot

# Bot HTTP API port (for web apps to call back)
BOT_HTTP_PORT=3100

# Super Admins (comma-separated Mezon User IDs for IT / setup technicians)
SUPER_ADMIN_IDS=mezon_user_id_1,mezon_user_id_2
