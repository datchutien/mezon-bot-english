generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String   @id @default(uuid())
  clanId          String   @unique @map("clan_id")
  name            String
  webAppUrl       String   @map("web_app_url")
  webAppApiSecret String   @map("web_app_api_secret")
  botVerifySecret String   @map("bot_verify_secret")

  config          Json     @default("{}")
  // config shape: { command_prefix: "*", language: "vi", welcome_message: "..." }

  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  commands        TenantCommand[]

  @@map("tenants")
}

model TenantCommand {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  commandName     String   @map("command_name")
  enabled         Boolean  @default(true)
  customAliases   String[] @map("custom_aliases")
  customConfig    Json     @default("{}") @map("custom_config")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, commandName])
  @@map("tenant_commands")
}
